<odoo><template id="report_rent_receipt"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Quittance de loyer</h2><p><strong>Référence :</strong> <span t-field="o.name"/></p><table class="table table-sm"><tr><th>Locataire</th><td t-field="o.tenant_id"/></tr><tr><th>Propriété / local</th><td><span t-field="o.property_id"/> — <span t-field="o.unit_id"/></td></tr><tr><th>Contrat</th><td t-field="o.lease_id"/></tr><tr><th>Période</th><td><span t-field="o.period_start"/> au <span t-field="o.period_end"/></td></tr><tr><th>Loyer</th><td t-field="o.rent_amount"/></tr><tr><th>Charges</th><td t-field="o.charge_amount"/></tr><tr><th>Montant payé</th><td t-field="o.paid_amount"/></tr><tr><th>Solde</th><td t-field="o.balance_amount"/></tr></table><p class="mt-4">Fait le <span t-field="o.invoice_id.invoice_date"/>. Référence facture : <span t-field="o.invoice_id.name"/></p></div></t></t></t></template></odoo>
