<odoo><template id="report_tenant_statement"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>Situation du compte locataire</h2><p><strong>Locataire :</strong> <span t-field="o.name"/></p><table class="table table-sm"><thead><tr><th>Échéance</th><th>Local</th><th>Période</th><th class="text-end">Total</th><th class="text-end">Payé</th><th class="text-end">Solde</th></tr></thead><tbody><tr t-foreach="o.estate_lease_ids.schedule_ids" t-as="line"><td t-field="line.date_due"/><td t-field="line.unit_id"/><td><span t-field="line.period_start"/> - <span t-field="line.period_end"/></td><td class="text-end" t-field="line.total_amount"/><td class="text-end" t-field="line.paid_amount"/><td class="text-end" t-field="line.balance_amount"/></tr></tbody></table><h4 class="text-end">Impayés : <span t-field="o.estate_unpaid_amount"/></h4></div></t></t></t></template></odoo>
