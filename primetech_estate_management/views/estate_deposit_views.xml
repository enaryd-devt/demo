<odoo>
    <record id="estate_deposit_action" model="ir.actions.act_window"><field name="name">Cautions</field><field name="res_model">estate.deposit</field><field name="view_mode">list,form</field></record>
    <record id="estate_deposit_payment_action" model="ir.actions.act_window"><field name="name">Versements de cautions</field><field name="res_model">estate.deposit.payment</field><field name="view_mode">list,form</field></record>
    <record id="estate_deposit_view_list" model="ir.ui.view"><field name="name">estate.deposit.list</field><field name="model">estate.deposit</field><field name="arch" type="xml"><list><field name="name"/><field name="lease_id"/><field name="tenant_id"/><field name="amount_required"/><field name="amount_paid"/><field name="amount_balance"/><field name="date"/><field name="state" widget="badge"/></list></field></record>
    <record id="estate_deposit_view_form" model="ir.ui.view"><field name="name">estate.deposit.form</field><field name="model">estate.deposit</field><field name="arch" type="xml"><form><header><button name="action_view_payments" type="object" string="Enregistrer / voir les versements" class="btn-primary"/><button name="action_return" type="object" string="Restituer" invisible="state != 'paid'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money"><field name="payment_count" widget="statinfo" string="Versements"/></button></div><group><group><field name="name" readonly="1"/><field name="lease_id"/><field name="tenant_id" readonly="1"/><field name="date"/></group><group><field name="amount_required"/><field name="amount_paid" readonly="1"/><field name="amount_balance" readonly="1"/></group></group><notebook><page string="Versements"><field name="payment_ids"><list><field name="date"/><field name="amount"/><field name="payment_method"/><field name="reference"/><field name="state" widget="badge"/></list></field></page><page string="Observations"><field name="history_note"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="estate_deposit_payment_view_list" model="ir.ui.view"><field name="name">estate.deposit.payment.list</field><field name="model">estate.deposit.payment</field><field name="arch" type="xml"><list><field name="date"/><field name="deposit_id"/><field name="tenant_id"/><field name="amount"/><field name="payment_method"/><field name="reference"/><field name="state" widget="badge"/></list></field></record>
    <record id="estate_deposit_payment_view_form" model="ir.ui.view"><field name="name">estate.deposit.payment.form</field><field name="model">estate.deposit.payment</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirmer" class="btn-primary" invisible="state != 'draft'"/><button name="action_cancel" type="object" string="Annuler" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="deposit_id"/><field name="tenant_id" readonly="1"/><field name="date"/><field name="amount"/><field name="payment_method"/><field name="reference"/></group><field name="note"/></sheet><chatter/></form></field></record>
</odoo>
