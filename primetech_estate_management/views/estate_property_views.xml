<odoo>
 <record id="estate_property_action" model="ir.actions.act_window"><field name="name">Propriétés / Immeubles</field><field name="res_model">estate.property</field><field name="view_mode">list,form,kanban</field></record>
 <record id="estate_property_view_list" model="ir.ui.view"><field name="name">estate.property.list</field><field name="model">estate.property</field><field name="arch" type="xml"><list><field name="reference"/><field name="name"/><field name="property_type_id"/><field name="city"/><field name="manager_id"/><field name="unit_count"/><field name="occupancy_rate" widget="percentage"/><field name="unpaid_amount"/><field name="state" widget="badge"/></list></field></record>
 <record id="estate_property_view_form" model="ir.ui.view"><field name="name">estate.property.form</field><field name="model">estate.property</field><field name="arch" type="xml"><form><header><field name="state" widget="statusbar"/></header><sheet><div class="oe_button_box" name="button_box"><button type="object" name="action_view_units" class="oe_stat_button" icon="fa-building-o"><field name="unit_count" widget="statinfo" string="Unités"/></button><button type="object" name="action_view_leases" class="oe_stat_button" icon="fa-file-text-o"><field name="lease_count" widget="statinfo" string="Contrats"/></button><button type="object" name="action_view_unpaid" class="oe_stat_button" icon="fa-exclamation-circle"><field name="unpaid_amount" widget="statinfo" string="Impayés"/></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><field name="reference" readonly="1"/></div><group><group><field name="property_type_id"/><field name="manager_id"/><field name="owner_id"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="street"/><field name="district"/><field name="city"/><field name="country_id"/></group></group><notebook><page string="Description"><field name="description"/></page><page string="Unités"><field name="unit_ids" context="{'default_property_id': id}"><list editable="bottom"><field name="name"/><field name="unit_type_id"/><field name="indicative_rent"/><field name="state"/></list></field></page><page string="Indicateurs"><group><field name="occupied_unit_count"/><field name="available_unit_count"/><field name="maintenance_unit_count"/><field name="occupancy_rate" widget="percentage"/><field name="rent_due"/><field name="unpaid_amount"/></group></page></notebook></sheet><chatter/></form></field></record>
</odoo>
