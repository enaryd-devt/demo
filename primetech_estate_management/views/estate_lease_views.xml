<odoo>
 <record id="estate_lease_action" model="ir.actions.act_window"><field name="name">Contrats de bail</field><field name="res_model">estate.lease</field><field name="view_mode">list,form,kanban,graph,pivot</field></record>
 <record id="estate_lease_view_list" model="ir.ui.view"><field name="name">estate.lease.list</field><field name="model">estate.lease</field><field name="arch" type="xml"><list><field name="name"/><field name="tenant_id"/><field name="property_id"/><field name="unit_id"/><field name="date_start"/><field name="date_end"/><field name="rent_amount"/><field name="unpaid_amount"/><field name="state" widget="badge"/></list></field></record>
 <record id="estate_lease_view_form" model="ir.ui.view"><field name="name">estate.lease.form</field><field name="model">estate.lease</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Soumettre" class="btn-primary" invisible="state != 'draft'"/><button name="action_activate" type="object" string="Activer" class="btn-primary" invisible="state not in ['draft','submitted']"/><button name="action_renew" type="object" string="Renouveler" invisible="state != 'active'"/><button name="action_terminate" type="object" string="Résilier" invisible="state != 'active'"/><button name="action_close" type="object" string="Clôturer" invisible="state not in ['active','expired','terminated']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,active,expired,closed"/></header><sheet><div class="oe_button_box" name="button_box"><button type="object" name="action_view_schedules" class="oe_stat_button" icon="fa-calendar"><field name="schedule_count" widget="statinfo" string="Échéances"/></button><field name="unpaid_amount" widget="statinfo" string="Impayés"/></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="tenant_id"/><field name="property_id"/><field name="unit_id"/><field name="date_signature"/></group><group><field name="date_start"/><field name="date_end"/><field name="duration_months"/><field name="frequency"/><field name="due_day"/></group></group><group string="Conditions financières"><field name="rent_amount"/><field name="charge_amount"/><field name="deposit_amount"/><field name="advance_amount"/></group><notebook><page string="Échéancier"><field name="schedule_ids" readonly="state not in ['draft','submitted']"><list><field name="name"/><field name="date_due"/><field name="total_amount"/><field name="paid_amount"/><field name="balance_amount"/><field name="state"/></list></field></page><page string="Conditions"><field name="special_terms"/><field name="note"/><field name="signed_document" filename="signed_document_filename"/></page></notebook></sheet><chatter/></form></field></record>
</odoo>
