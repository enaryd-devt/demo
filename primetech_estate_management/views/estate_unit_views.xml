<odoo>
    <record id="estate_unit_action" model="ir.actions.act_window">
        <field name="name">Locaux</field>
        <field name="res_model">estate.unit</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="estate_unit_view_list" model="ir.ui.view">
        <field name="name">estate.unit.list</field>
        <field name="model">estate.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="property_id"/>
                <field name="name"/>
                <field name="unit_type_id"/>
                <field name="indicative_rent"/>
                <field name="tenant_id"/>
                <field name="maintenance_open_count" string="Interventions" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="estate_unit_view_form" model="ir.ui.view">
        <field name="name">estate.unit.form</field>
        <field name="model">estate.unit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_maintenance_request" type="object"
                            string="Demander une maintenance" icon="fa-wrench"
                            class="btn-secondary"
                            groups="primetech_estate_management.group_estate_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_leases" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="lease_count" widget="statinfo" string="Contrats"/>
                        </button>
                        <button type="object" name="action_view_maintenance_requests" class="oe_stat_button"
                                icon="fa-wrench" groups="primetech_estate_management.group_estate_manager">
                            <field name="maintenance_request_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="reference" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="unit_type_id"/>
                            <field name="floor"/>
                            <field name="surface"/>
                            <field name="room_count"/>
                        </group>
                        <group>
                            <field name="indicative_rent"/>
                            <field name="indicative_charge"/>
                            <field name="deposit_required"/>
                            <field name="tenant_id" readonly="1"/>
                            <field name="current_lease_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Maintenance" groups="primetech_estate_management.group_estate_manager">
                            <field name="maintenance_request_ids" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="name"/>
                                    <field name="maintenance_type"/>
                                    <field name="request_date"/>
                                    <field name="schedule_date"/>
                                    <field name="user_id"/>
                                    <field name="stage_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>
