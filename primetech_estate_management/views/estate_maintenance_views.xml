<odoo>
    <record id="estate_maintenance_request_action" model="ir.actions.act_window">
        <field name="name">Maintenance des locaux</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">list,form,kanban,pivot,graph,calendar,activity</field>
        <field name="domain">[('estate_unit_id', '!=', False)]</field>
        <field name="context">{'search_default_active': True, 'default_maintenance_type': 'corrective'}</field>
    </record>

    <record id="maintenance_request_view_form_estate" model="ir.ui.view">
        <field name="name">maintenance.request.form.estate</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="estate_unit_id" options="{'no_create': True}"/>
                <field name="estate_property_id" readonly="1"/>
                <field name="estate_cost_amount" readonly="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_estate_charge" type="object" string="Ajouter un coût" icon="fa-money"
                        invisible="not estate_unit_id" groups="primetech_estate_management.group_estate_manager"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_view_list_estate" model="ir.ui.view">
        <field name="name">maintenance.request.list.estate</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="estate_property_id" optional="show"/>
                <field name="estate_unit_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="maintenance_request_view_search_estate" model="ir.ui.view">
        <field name="name">maintenance.request.search.estate</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="estate_property_id"/>
                <field name="estate_unit_id"/>
            </xpath>
            <xpath expr="//filter[@name='filter_request_date']" position="before">
                <filter name="estate_unit_requests" string="Locaux immobiliers"
                        domain="[('estate_unit_id', '!=', False)]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Immeuble" name="group_by_estate_property" domain="[]"
                        context="{'group_by': 'estate_property_id'}"/>
                <filter string="Local" name="group_by_estate_unit" domain="[]"
                        context="{'group_by': 'estate_unit_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
