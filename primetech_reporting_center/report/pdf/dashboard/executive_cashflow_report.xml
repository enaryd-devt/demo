<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_executive_cashflow" model="report.paperformat">
        <field name="name">Rapport de trésorerie exécutif - A4 portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">38</field>
        <field name="margin_bottom">26</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">7</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_executive_cashflow_pdf" model="ir.actions.report">
        <field name="name">Rapport de suivi de trésorerie</field>
        <field name="model">res.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">primetech_reporting_center.executive_cashflow_pdf</field>
        <field name="report_file">primetech_reporting_center.executive_cashflow_pdf</field>
        <field name="paperformat_id" eval="False"/>
        <field name="print_report_name">'Rapport_tresorerie_%s' % (object.name)</field>
    </record>
</odoo>
