                        <div style="margin-top: 4px; font-size: 10px;">Exercice du <strong t-esc="data['date_from']"/> au <strong t-esc="data['date_to']"/></div>
                        <div t-if="data['company'].name" style="margin-top: 3px; color: #52657e;"><t t-esc="data['company'].name"/></div>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                        <thead style="display: table-header-group;">
                            <tr style="background: #1b366a; color: #ffffff;">
                                <th style="width: 6%; border: 1px solid #1b366a; padding: 6px 3px;">RÉF.</th>
                                <th style="width: 48%; border: 1px solid #1b366a; padding: 6px 4px; text-align: left;">LIBELLÉS</th>
                                <th style="width: 5%; border: 1px solid #1b366a; padding: 6px 2px;">&#160;</th>
                                <th style="width: 7%; border: 1px solid #1b366a; padding: 6px 2px;">SIGNE</th>
                                <th style="width: 7%; border: 1px solid #1b366a; padding: 6px 2px;">NOTE</th>
                                <th style="width: 14%; border: 1px solid #1b366a; padding: 6px 3px;">EXERCICE <t t-esc="data['year_n']"/></th>
                                <th style="width: 13%; border: 1px solid #1b366a; padding: 6px 3px;">EXERCICE <t t-esc="data['year_n1']"/></th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data['lines']" t-as="line">
                                <tr t-att-style="line['line_type'] == 'grand_total' and 'background:#1b366a; color:#ffffff; font-weight:700;' or (line['line_type'] == 'subtotal' and 'background:#e8eef8; font-weight:700;' or '')">
                                    <td style="border: 1px solid #b8c5d8; padding: 4px 3px; text-align: center;"><t t-esc="line['ref']"/></td>
