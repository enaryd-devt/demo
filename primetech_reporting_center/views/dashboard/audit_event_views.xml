<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_primetech_audit_event_list" model="ir.ui.view">
        <field name="name">primetech.audit.event.list</field>
        <field name="model">primetech.audit.event</field>
        <field name="arch" type="xml">
            <list string="Historique des activités et journal d'audit" create="0" edit="0" delete="0" default_order="event_date desc">
                <field name="event_date"/>
                <field name="user_id"/>
                <field name="user_role" optional="show"/>
                <field name="event_type" decoration-info="event_type == 'print'" decoration-warning="event_type == 'write'" decoration-danger="event_type == 'unlink'" decoration-success="event_type == 'create'" widget="badge"/>
                <field name="action_label"/>
                <field name="document_name"/>
                <field name="model_label"/>
                <field name="details" optional="show"/>
                <field name="ip_address" optional="show"/>
                <field name="device_info" optional="show"/>
                <button name="open_document" type="object" icon="fa-external-link" title="Ouvrir le document" invisible="not res_id"/>
            </list>
        </field>
    </record>

    <record id="view_primetech_audit_event_search" model="ir.ui.view">
        <field name="name">primetech.audit.event.search</field>
        <field name="model">primetech.audit.event</field>
        <field name="arch" type="xml">
            <search string="Rechercher dans l'historique">
                <field name="action_label"/>
                <field name="document_name"/>
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="model_label"/>
                <filter name="create" string="Créations" domain="[('event_type', '=', 'create')]"/>
                <filter name="write" string="Modifications" domain="[('event_type', '=', 'write')]"/>
                <filter name="unlink" string="Suppressions" domain="[('event_type', '=', 'unlink')]"/>
                <filter name="print" string="Impressions" domain="[('event_type', '=', 'print')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_user" string="Utilisateur" context="{'group_by': 'user_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'event_type'}"/>
                    <filter name="group_model" string="Objet" context="{'group_by': 'model_label'}"/>
                    <filter name="group_day" string="Jour" context="{'group_by': 'event_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
