<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
<t t-name="primetech_reporting_center.PurchaseOverviewDashboard">
<div class="pt-purchase-overview">
    <t t-if="state.loading">
        <div class="pt-purchase-loading"><i class="fa fa-spinner fa-spin fa-3x"/><h4>Chargement du Dashboard...</h4></div>
    </t>
    <t t-else="">
        <header class="pt-purchase-header"><h1>Achats - Vue d'ensemble</h1><div class="pt-purchase-icons"><button t-on-click="refresh"><i class="fa fa-refresh"/></button><button><i class="fa fa-cog"/></button><button><i class="fa fa-expand"/></button></div></header>
        <section class="pt-purchase-filters"><label>Société<select><option>Toutes les sociétés</option></select></label><label>Période<select t-att-value="state.period" t-on-change="(ev) => this.setPeriod(ev.target.value)"><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option></select></label><label>Comparaison<select><option>Période précédente</option></select></label><span>Actualisé le : <t t-esc="state.data.updated_at"/></span></section>

        <section class="pt-purchase-kpis">
            <button class="pt-purchase-kpi" t-on-click="() => this.openOrders()"><span>Total des achats</span><strong><t t-esc="money(state.data.total_ht)"/></strong><em>▲ <t t-esc="pct(state.data.growth_percentage)"/></em><small><t t-esc="money(state.data.previous_total_ht)"/></small></button>
            <button class="pt-purchase-kpi" t-on-click="() => this.openBills()"><span>Achats facturés</span><strong><t t-esc="money(state.data.billed_amount)"/></strong><em>▲ <t t-esc="pct(state.data.billed_growth)"/></em><small><t t-esc="money(state.data.previous_billed_amount)"/></small></button>
            <button class="pt-purchase-kpi" t-on-click="() => this.openBills([['payment_state', 'in', ['paid', 'in_payment']]])"><span>Achats payés</span><strong><t t-esc="money(state.data.paid_amount)"/></strong><em>▲ <t t-esc="pct(state.data.paid_growth)"/></em><small><t t-esc="money(state.data.previous_paid_amount)"/></small></button>
            <button class="pt-purchase-kpi" t-on-click="() => this.openOrders([['state', 'in', ['purchase', 'done']]])"><span>Commandes en cours</span><strong><t t-esc="state.data.purchase_count"/></strong><em>▲ <t t-esc="pct(state.data.order_growth)"/></em><small><t t-esc="state.data.previous_purchase_count"/></small></button>
            <button class="pt-purchase-kpi" t-on-click="() => this.openReceipts()"><span>Réceptions en retard</span><strong><t t-esc="state.data.late_receipts_count"/></strong><em class="down">▼ <t t-esc="pct(state.data.late_receipts_growth)"/></em><small><t t-esc="state.data.previous_late_receipts_count"/></small></button>
            <button class="pt-purchase-kpi" t-on-click="() => this.openOrders()"><span>Économies réalisées</span><strong><t t-esc="money(state.data.savings_amount)"/></strong><em>▲ <t t-esc="pct(state.data.savings_growth)"/></em><small><t t-esc="money(state.data.previous_savings_amount)"/></small></button>
            <button class="pt-purchase-kpi" t-on-click="() => this.openOrders()"><span>Délai moyen fournisseur</span><strong><t t-esc="state.data.average_supplier_delay"/> jours</strong><em>▲ <t t-esc="pct(state.data.delay_growth)"/></em><small><t t-esc="state.data.previous_average_supplier_delay"/> jours</small></button>
        </section>

        <section class="pt-purchase-grid-top">
            <article class="pt-purchase-card pt-cycle"><h3>Cycle d'achat</h3><div class="pt-cycle-steps">
                <button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_analysis_report')"><i class="fa fa-file-o blue"/><span>Demande d'achat</span><strong><t t-esc="state.data.cycle.purchase_requests"/></strong></button>
                <button t-on-click="() => this.openOrders([['state', '=', 'draft']])"><i class="fa fa-file-text-o blue"/><span>À approuver</span><strong><t t-esc="state.data.cycle.to_approve"/></strong></button>
                <button t-on-click="() => this.openOrders([['state', 'in', ['purchase', 'done']]])"><i class="fa fa-check-square-o green"/><span>Approuvées</span><strong><t t-esc="state.data.cycle.approved"/></strong></button>
                <button t-on-click="() => this.openOrders([['state', 'in', ['draft', 'sent']]])"><i class="fa fa-cart-arrow-down blue"/><span>Demandes fournisseurs</span><strong><t t-esc="state.data.cycle.vendor_requests"/></strong></button>
                <button t-on-click="() => this.openOrders([['state', 'in', ['purchase', 'done']]])"><i class="fa fa-shopping-cart orange"/><span>Commandes confirmées</span><strong><t t-esc="state.data.cycle.confirmed"/></strong></button>
                <button t-on-click="() => this.openReceipts([['state', 'not in', ['done', 'cancel']]])"><i class="fa fa-inbox orange"/><span>À recevoir</span><strong><t t-esc="state.data.cycle.to_receive"/></strong></button>
                <button t-on-click="() => this.openBills([['state', '=', 'draft']])"><i class="fa fa-file-pdf-o red"/><span>À facturer</span><strong><t t-esc="state.data.cycle.to_bill"/></strong></button>
            </div></article>
            <article class="pt-purchase-card"><h3>Top 5 fournisseurs (CA)</h3><table><thead><tr><th>Fournisseur</th><th>Achats</th><th>Évolution</th><th>Délai moyen</th><th>Taux livraison</th></tr></thead><tbody><tr t-foreach="state.data.top_suppliers || []" t-as="supplier" t-key="supplier.id" t-on-click="() => this.openSuppliers([supplier.id])"><td><t t-esc="supplier.name"/></td><td><t t-esc="money(supplier.amount)"/></td><td class="positive">▲ <t t-esc="pct(supplier.growth)"/></td><td><t t-esc="supplier.delay"/> jrs</td><td><t t-esc="pct(supplier.delivery_rate)"/></td></tr></tbody></table></article>
        </section>

        <section class="pt-purchase-grid-bottom">
            <article class="pt-purchase-card"><h3>Répartition des achats par catégorie</h3><div class="pt-chart-with-list"><div class="pt-chart-box"><canvas id="pt_purchase_category_chart"/></div><ul><li t-foreach="state.data.expense_by_category || []" t-as="cat" t-key="cat.category" t-on-click="() => this.openProducts(cat.product_ids)"><b/><span><t t-esc="cat.category"/></span><strong><t t-esc="money(cat.amount)"/></strong></li></ul></div><button class="pt-card-link" t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_analysis_report')">Voir l'analyse complète</button></article>
            <article class="pt-purchase-card"><h3>Commandes &amp; réceptions</h3><div class="pt-chart-with-list"><div class="pt-chart-box"><canvas id="pt_purchase_orders_chart"/></div><ul><li t-foreach="state.data.order_reception_split || []" t-as="item" t-key="item.label" t-on-click="() => item.model === 'stock.picking' ? this.openReceipts(item.domain) : this.openOrders(item.domain)"><b/><span><t t-esc="item.label"/></span><strong><t t-esc="item.value"/> (<t t-esc="pct(item.percent)"/>)</strong></li></ul></div><button class="pt-card-link" t-on-click="() => this.openOrders()">Voir toutes les commandes</button></article>
            <article class="pt-purchase-card pt-purchase-alerts"><h3>Alertes achats</h3><button t-on-click="() => this.openOrders([['state', '=', 'draft']])"><i class="fa fa-exclamation-circle"/> <t t-esc="state.data.alerts.to_approve"/> demandes à approuver</button><button t-on-click="() => this.openReceipts([['scheduled_date', '&lt;', state.data.today], ['state', 'not in', ['done', 'cancel']]])"><i class="fa fa-clock-o"/> <t t-esc="state.data.alerts.late_receipts"/> réceptions en retard</button><button t-on-click="() => this.openBills([['state', '=', 'draft']])"><i class="fa fa-file-text-o"/> <t t-esc="state.data.alerts.draft_bills"/> factures en litige</button><button t-on-click="() => this.openOrders([['state', 'in', ['purchase', 'done']]])"><i class="fa fa-warning"/> <t t-esc="state.data.alerts.price_anomalies"/> hausses de prix anormales</button><button t-on-click="() => this.openSuppliers()"><i class="fa fa-user-times"/> <t t-esc="state.data.alerts.non_compliant_suppliers"/> fournisseurs non homologués</button><button class="pt-alert-link" t-on-click="() => this.openOrders([['state', '=', 'draft']])">Voir toutes les alertes</button></article>
        </section>

        <section class="pt-purchase-actions"><h3>Actions rapides</h3><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_analysis_report')"><i class="fa fa-file-o blue"/> Nouvelle demande</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_supplier_report')"><i class="fa fa-file-excel-o green"/> Demande de prix</button><button t-on-click="() => this.openOrders([['state', '=', 'draft']])"><i class="fa fa-file-text-o green"/> Nouvelle commande</button><button t-on-click="() => this.openReceipts()"><i class="fa fa-truck purple"/> Enregistrer réception</button><button t-on-click="() => this.openBills([['state', '=', 'draft']])"><i class="fa fa-file-text-o blue"/> Nouvelle facture</button><button t-on-click="() => this.openSuppliers()"><i class="fa fa-user-plus orange"/> Évaluer fournisseur</button><button t-on-click="() => this.openWizard('primetech_reporting_center.action_purchase_supplier_perf_report')"><i class="fa fa-file-pdf-o teal"/> Rapport achats</button></section>
    </t>
</div>
</t>
</templates>
