<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="primetech_reporting_center.HROverviewDashboard" owl="1">
<main class="pt-hr-dashboard">
    <t t-if="state.loading"><div class="pt-hr-loading"><i class="fa fa-spinner fa-spin fa-3x"/> Chargement des données RH…</div></t>
    <t t-else="">
        <header class="pt-hr-header"><h1>Ressources Humaines - Vue d'ensemble</h1><div class="pt-hr-icons"><button t-on-click="() => this.loadDashboard()"><i class="fa fa-refresh"/></button><button><i class="fa fa-cog"/></button><button><i class="fa fa-expand"/></button></div></header>
        <section class="pt-hr-filters"><label>Société<select><option>Toutes les sociétés</option></select></label><label>Période<select t-att-value="state.period" t-on-change="onPeriodChange"><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option></select></label><label>Département<select t-att-value="state.departmentId" t-on-change="onDepartmentChange"><option value="">Tous les départements</option><t t-foreach="state.departmentOptions" t-as="department" t-key="department.id"><option t-att-value="department.id"><t t-esc="department.name"/></option></t></select></label><span>Actualisé le : <t t-esc="state.data.updated_at"/></span></section>

        <section class="pt-hr-kpis">
            <button class="pt-hr-kpi" t-on-click="() => this.openEmployees()"><span>Effectif total</span><strong><t t-esc="state.data.employees"/></strong><em>▲ <t t-esc="pct(state.data.employee_growth)"/></em><small><t t-esc="state.data.previous_employees"/></small></button>
            <button class="pt-hr-kpi" t-on-click="() => this.openAttendances()"><span>Présents aujourd'hui</span><strong><t t-esc="state.data.attendance_today"/></strong><em>▲ <t t-esc="pct(state.data.attendance_growth)"/></em><small><t t-esc="state.data.previous_attendance_today"/></small></button>
            <button class="pt-hr-kpi" t-on-click="() => this.openEmployees([['id', 'in', state.data.absent_employee_ids]])"><span>Absents aujourd'hui</span><strong><t t-esc="state.data.absent_today"/></strong><em>▲ <t t-esc="pct(state.data.absent_growth)"/></em><small><t t-esc="state.data.previous_absent_today"/></small></button>
            <button class="pt-hr-kpi" t-on-click="() => this.openLeaves([['state', '=', 'validate']])"><span>En congé</span><strong><t t-esc="state.data.on_leave"/></strong><em>▲ <t t-esc="pct(state.data.leave_growth)"/></em><small><t t-esc="state.data.previous_on_leave"/></small></button>
            <button class="pt-hr-kpi" t-on-click="() => this.openEmployees([['create_date', '&gt;=', state.data.period_start]])"><span>Nouveaux employés</span><strong><t t-esc="state.data.new_hires"/></strong><em>▲ <t t-esc="pct(state.data.new_hire_growth)"/></em><small><t t-esc="state.data.previous_new_hires"/></small></button>
            <button class="pt-hr-kpi" t-on-click="() => this.openEmployees([['create_date', '&lt;', state.data.period_start]])"><span>Départs</span><strong><t t-esc="state.data.departures"/></strong><em>▲ <t t-esc="state.data.previous_departures"/></em><small><t t-esc="state.data.previous_departures"/></small></button>
            <button class="pt-hr-kpi" t-on-click="() => this.openPayroll()"><span>Masse salariale</span><strong><t t-esc="money(state.data.payroll_mass)"/></strong><em>▲ <t t-esc="pct(state.data.payroll_growth)"/></em><small><t t-esc="money(state.data.previous_payroll_mass)"/></small></button>
            <button class="pt-hr-kpi" t-on-click="() => this.openEmployees([['id', 'in', state.data.absent_employee_ids]])"><span>Taux d'absentéisme</span><strong><t t-esc="pct(state.data.absenteeism_rate)"/></strong><em>▲ <t t-esc="pct(state.data.absenteeism_growth)"/></em><small><t t-esc="pct(state.data.previous_absenteeism_rate)"/></small></button>
        </section>

        <section class="pt-hr-grid-top">
            <article class="pt-hr-card"><h3>Répartition par département</h3><div class="pt-hr-chart-list"><div class="pt-hr-chart"><canvas id="hrDepartmentChart"/></div><ul><li t-foreach="state.data.department_cards || []" t-as="department" t-key="department.id" t-on-click="() => this.openEmployees([['department_id', '=', department.id]])"><b/><span><t t-esc="department.name"/></span><strong><t t-esc="pct(department.percent)"/></strong></li></ul></div></article>
            <article class="pt-hr-card"><h3>Présence du jour</h3><div class="pt-hr-chart presence"><canvas id="hrPresenceChart"/></div></article>
            <article class="pt-hr-card"><h3>Demandes de congé</h3><div class="pt-hr-list"><button t-on-click="() => this.openLeaves([['state', 'in', ['confirm', 'validate1']]])"><span>À approuver</span><strong><t t-esc="state.data.leave_pending"/></strong></button><button t-on-click="() => this.openLeaves([['state', '=', 'validate']])"><span>Validées</span><strong><t t-esc="state.data.leave_validated"/></strong></button><button t-on-click="() => this.openLeaves([['state', 'in', ['confirm', 'validate1']]])"><span>En cours</span><strong><t t-esc="state.data.leave_running"/></strong></button><button t-on-click="() => this.openLeaves([['state', '=', 'refuse']])"><span>Refusées</span><strong><t t-esc="state.data.leave_refused"/></strong></button></div><button class="pt-card-link" t-on-click="() => this.openLeaves()">Voir toutes les demandes</button></article>
        </section>

        <section class="pt-hr-grid-bottom">
            <article class="pt-hr-card"><h3>Contrats</h3><div class="pt-hr-list"><button t-on-click="() => this.openContracts([['state', '=', 'open']])"><span>Actifs</span><strong><t t-esc="state.data.contracts"/></strong></button><button t-on-click="() => this.openContracts([['state', '=', 'draft']])"><span>À renouveler</span><strong><t t-esc="state.data.contracts_to_renew"/></strong></button><button t-on-click="() => this.openContracts([['date_end', '&lt;=', state.data.alert_date]])"><span>Expirant &lt; 30 jours</span><strong><t t-esc="state.data.contracts_expiring"/></strong></button><button t-on-click="() => this.openContracts([['trial_date_end', '&lt;=', state.data.alert_date]])"><span>Période d'essai</span><strong><t t-esc="state.data.trials_expiring"/></strong></button><button t-on-click="() => this.openEmployees([['id', 'in', state.data.no_contract_employee_ids]])"><span>Sans contrat</span><strong><t t-esc="state.data.no_contract"/></strong></button></div><button class="pt-card-link" t-on-click="() => this.openContracts()">Voir tous les contrats</button></article>
            <article class="pt-hr-card"><h3>Paie (Mois en cours)</h3><div class="pt-hr-list"><button t-on-click="() => this.openPayroll()"><span>Bulletins à générer</span><strong><t t-esc="state.data.payroll.to_generate"/></strong></button><button t-on-click="() => this.openPayroll([['state', '=', 'verify']])"><span>Bulletins à valider</span><strong><t t-esc="state.data.payroll.to_validate"/></strong></button><button t-on-click="() => this.openPayroll()"><span>Bulletins validés</span><strong><t t-esc="state.data.payroll.validated"/></strong></button><button t-on-click="() => this.openPayroll([['state', '=', 'done']])"><span>Bulletins payés</span><strong><t t-esc="state.data.payroll.paid"/></strong></button><button t-on-click="() => this.openPayroll()"><span>Masse salariale brute</span><strong><t t-esc="money(state.data.payroll_mass)"/></strong></button></div><button class="pt-card-link" t-on-click="() => this.openPayroll()">Voir la paie</button></article>
            <article class="pt-hr-card pt-hr-alerts"><h3>Alertes RH</h3><button t-on-click="() => this.openContracts([['date_end', '&lt;=', state.data.alert_date]])"><i class="fa fa-exclamation-circle"/> <t t-esc="state.data.alerts.contracts_expiring"/> contrats expirent bientôt</button><button t-on-click="() => this.openLeaves([['state', 'in', ['confirm', 'validate1']]])"><i class="fa fa-clock-o"/> <t t-esc="state.data.alerts.leave_pending"/> congés à approuver</button><button t-on-click="() => this.openAttendances()"><i class="fa fa-list"/> <t t-esc="state.data.alerts.incomplete_attendances"/> pointages incomplets</button><button t-on-click="() => this.openEmployees([['id', 'in', state.data.absent_employee_ids]])"><i class="fa fa-user-times"/> <t t-esc="state.data.alerts.unjustified_absences"/> absences non justifiées</button><button t-on-click="() => this.openEmployees([['id', 'in', state.data.no_contract_employee_ids]])"><i class="fa fa-warning"/> <t t-esc="state.data.alerts.employees_late"/> évaluations en retard</button><button class="pt-alert-link" t-on-click="() => this.openEmployees([['id', 'in', state.data.absent_employee_ids]])">Voir toutes les alertes</button></article>
        </section>

        <section class="pt-hr-actions"><h3>Actions rapides</h3><button t-on-click="() => this.openEmployees()"><i class="fa fa-user-plus teal"/> Nouvel employé</button><button t-on-click="() => this.openContracts()"><i class="fa fa-file-text-o red"/> Contrat</button><button t-on-click="() => this.openAttendances()"><i class="fa fa-clock-o green"/> Pointage</button><button t-on-click="() => this.openLeaves()"><i class="fa fa-user orange"/> Congé</button><button t-on-click="() => this.openPayroll()"><i class="fa fa-file-text-o purple"/> Paie</button><button t-on-click="() => this.openEmployees()"><i class="fa fa-user-o slate"/> Évaluation</button><button t-on-click="() => this.openEmployees()"><i class="fa fa-file-pdf-o blue"/> Rapport RH</button></section>
    </t>
</main>
</t>
</templates>
