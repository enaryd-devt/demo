<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="primetech_reporting_center.ExecutiveBoard" owl="1">
    <div class="pt-exec-board" t-ref="board">
        <header class="pt-eb-header" data-scroll-key="header">
            <div class="pt-eb-title">
                <h1>Tableau de bord exécutif</h1>
                <p>Vue d'ensemble de la chaîne de supermarchés</p>
            </div>
            <div class="pt-eb-top-controls">
                <button><t t-esc="todayLabel()"/> <i class="fa fa-calendar-o"/></button>
                <button><t t-esc="timeLabel()"/> <i class="fa fa-clock-o"/></button>
                <div class="pt-eb-global-period">
                    <label class="pt-eb-filter-control pt-eb-filter-control-top"><select class="pt-eb-filter-select" aria-label="Période d'analyse" t-att-value="state.period" t-on-change="onPeriodChange"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="year">Cette année</option><option value="custom">Période</option></select></label>
                    <div t-if="state.period === 'custom'" class="pt-eb-custom-dates">
                        <label>Du <input type="date" aria-label="Date de début" t-att-value="state.dateFrom" t-att-max="state.dateTo || undefined" t-on-change="(ev) => this.onCustomDateChange('dateFrom', ev)"/></label>
                        <label>Au <input type="date" aria-label="Date de fin" t-att-value="state.dateTo" t-att-min="state.dateFrom || undefined" t-on-change="(ev) => this.onCustomDateChange('dateTo', ev)"/></label>
                    </div>
                </div>
                <button>Tous les sites <i class="fa fa-map-marker"/></button>
                <div class="pt-eb-profile"><span class="pt-eb-avatar"><t t-esc="userInitials()"/></span><p><strong><t t-esc="state.current_user.name"/></strong><small><i class="pt-eb-live-dot"/> <t t-esc="state.current_user.status"/></small></p></div>
            </div>
        </header>

        <section class="pt-eb-kpis" data-scroll-key="summary-kpis">
            <t t-foreach="state.kpis" t-as="kpi" t-key="kpi.label">
                <article t-att-class="'pt-eb-kpi tone-' + kpi.tone" t-on-click="() => this.openAction(kpi.action)">
                    <div class="pt-eb-icon"><i t-att-class="kpi.icon"/></div>
                    <div><span><t t-esc="kpi.label"/></span><strong class="pt-eb-kpi-value" t-att-title="format(kpi.value, kpi.suffix)" t-att-data-full-value="format(kpi.value, kpi.suffix)" t-att-data-compact-value="formatKpiValue(kpi.value, kpi.suffix)"><t t-esc="format(kpi.value, kpi.suffix)"/></strong><small><t t-esc="kpi.trend"/></small></div>
                </article>
            </t>
        </section>

        <section class="pt-eb-partner-kpis" data-scroll-key="partner-kpis">
            <article t-att-class="'pt-eb-card pt-eb-partner-kpi' + (state.partnerSearchLoading.customers ? ' is-searching' : '') + (state.partnerSearch.customers ? ' has-search' : '')">
                <header><div><h3>Top créances client</h3><small>Total global : <t t-esc="format(state.partner_balance_kpis.customers.total, 'FCFA')"/> · affichés : <t t-esc="state.partner_balance_kpis.customers.filtered_count || 0"/></small></div><div class="pt-eb-partner-tools"><select class="pt-eb-filter-select" t-att-value="state.kpiFilters.customer_receivable_filter" t-on-change="(ev) => this.onKpiFilterChange('customer_receivable_filter', ev)"><option value="all">Tous</option><option value="high">Soldes élevés</option><option value="with_debit">Avec débits</option><option value="with_credit">Avec règlements</option><option value="without_payment">Sans règlement</option></select><button class="pt-eb-detail-link" t-on-click="() => this.openAction(state.partner_balance_kpis.customers.action)">Voir plus</button></div></header>
                <div class="pt-eb-partner-total"><span>Total solde débiteur</span><strong><t t-esc="format(state.partner_balance_kpis.customers.total, 'FCFA')"/></strong><small><t t-esc="state.partner_balance_kpis.customers.count || 0"/> clients</small></div>
                <div class="pt-eb-partner-search"><label><i class="fa fa-search"/><input type="search" placeholder="Rechercher automatiquement…" aria-label="Rechercher un client dans toutes les créances" t-att-value="state.partnerSearch.customers" t-on-input="(ev) => this.onPartnerSearchInput('customers', ev)" autocomplete="off"/></label></div>
                <table><thead><tr><th>Client</th><th>Débit</th><th>Crédit</th><th>Solde</th><th>État</th></tr></thead><tbody><tr t-if="state.partnerSearchLoading.customers"><td colspan="5" class="pt-eb-partner-loading"><i class="fa fa-spinner fa-spin"/><span>Recherche en cours…</span></td></tr><t t-else=""><t t-foreach="state.partner_balance_kpis.customers.rows" t-as="row" t-key="row.partner_id"><tr t-on-click="() => this.openAction(row.action)"><td><t t-esc="row.partner"/></td><td><t t-esc="format(row.debit, 'FCFA')"/></td><td><t t-esc="format(row.credit, 'FCFA')"/></td><td><strong><t t-esc="format(row.balance, 'FCFA')"/></strong></td><td><span t-att-class="'pt-eb-status-pill ' + (row.status_class || '')"><t t-esc="row.status"/></span></td></tr></t><tr t-if="!(state.partner_balance_kpis.customers.rows || []).length"><td colspan="5" class="pt-eb-partner-empty">Aucun client trouvé</td></tr></t></tbody></table>
            </article>
            <article t-att-class="'pt-eb-card pt-eb-partner-kpi' + (state.partnerSearchLoading.suppliers ? ' is-searching' : '') + (state.partnerSearch.suppliers ? ' has-search' : '')">
                <header><div><h3>Top créances fournisseur</h3><small>Total global : <t t-esc="format(state.partner_balance_kpis.suppliers.total, 'FCFA')"/> · affichés : <t t-esc="state.partner_balance_kpis.suppliers.filtered_count || 0"/></small></div><div class="pt-eb-partner-tools"><select class="pt-eb-filter-select" t-att-value="state.kpiFilters.supplier_receivable_filter" t-on-change="(ev) => this.onKpiFilterChange('supplier_receivable_filter', ev)"><option value="all">Tous</option><option value="high">Soldes élevés</option><option value="with_debit">Avec règlements</option><option value="with_credit">Avec crédits</option><option value="without_payment">Sans règlement</option></select><button class="pt-eb-detail-link" t-on-click="() => this.openAction(state.partner_balance_kpis.suppliers.action)">Voir plus</button></div></header>
                <div class="pt-eb-partner-total"><span>Total solde créditeur</span><strong><t t-esc="format(state.partner_balance_kpis.suppliers.total, 'FCFA')"/></strong><small><t t-esc="state.partner_balance_kpis.suppliers.count || 0"/> fournisseurs</small></div>
                <div class="pt-eb-partner-search"><label><i class="fa fa-search"/><input type="search" placeholder="Rechercher automatiquement…" aria-label="Rechercher un fournisseur dans toutes les créances" t-att-value="state.partnerSearch.suppliers" t-on-input="(ev) => this.onPartnerSearchInput('suppliers', ev)" autocomplete="off"/></label></div>
                <table><thead><tr><th>Fournisseur</th><th>Débit</th><th>Crédit</th><th>Solde</th><th>État</th></tr></thead><tbody><tr t-if="state.partnerSearchLoading.suppliers"><td colspan="5" class="pt-eb-partner-loading"><i class="fa fa-spinner fa-spin"/><span>Recherche en cours…</span></td></tr><t t-else=""><t t-foreach="state.partner_balance_kpis.suppliers.rows" t-as="row" t-key="row.partner_id"><tr t-on-click="() => this.openAction(row.action)"><td><t t-esc="row.partner"/></td><td><t t-esc="format(row.debit, 'FCFA')"/></td><td><t t-esc="format(row.credit, 'FCFA')"/></td><td><strong><t t-esc="format(row.balance, 'FCFA')"/></strong></td><td><span t-att-class="'pt-eb-status-pill ' + (row.status_class || '')"><t t-esc="row.status"/></span></td></tr></t><tr t-if="!(state.partner_balance_kpis.suppliers.rows || []).length"><td colspan="5" class="pt-eb-partner-empty">Aucun fournisseur trouvé</td></tr></t></tbody></table>
            </article>
        </section>

        <section class="pt-eb-grid-main" data-scroll-key="main-analysis">
            <article class="pt-eb-card stores"><header class="pt-eb-card-filter-header"><div><h3>Ventes par magasin</h3><small>Répartition par lieu de service final</small></div><div class="pt-eb-card-period"><label class="pt-eb-filter-control"><select class="pt-eb-filter-select" aria-label="Période des ventes par magasin" t-att-value="state.kpiFilters.store_period" t-on-change="(ev) => this.onKpiFilterChange('store_period', ev)"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="year">Cette année</option><option value="custom">Période</option></select></label><div t-if="state.kpiFilters.store_period === 'custom'" class="pt-eb-card-custom-dates"><label>Du<input type="date" aria-label="Date de début" t-att-value="kpiCustomRange('store_period').dateFrom" t-att-max="kpiCustomRange('store_period').dateTo || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('store_period', 'dateFrom', ev)"/></label><label>Au<input type="date" aria-label="Date de fin" t-att-value="kpiCustomRange('store_period').dateTo" t-att-min="kpiCustomRange('store_period').dateFrom || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('store_period', 'dateTo', ev)"/></label></div></div></header>
                <t t-foreach="state.stores" t-as="store" t-key="store.name">
                    <div class="pt-eb-store" t-on-click="() => this.openAction(store.action)"><span><t t-esc="store.name"/></span><div><b t-att-class="'bar tone-' + store.tone" t-att-style="'width:' + store.percent + '%'"/></div><strong><t t-esc="format(store.value, 'FCFA')"/></strong></div>
                </t>
            </article>
            <article class="pt-eb-card pt-revenue-category-kpi"><div class="pt-revenue-kpi"><header><div><h3>Évolution du chiffre d'affaires</h3><small><t t-esc="state.revenue_chart.subtitle"/></small></div><div class="pt-eb-card-period"><label class="pt-eb-filter-control"><select class="pt-eb-filter-select" aria-label="Période d'évolution du chiffre d'affaires" t-att-value="state.kpiFilters.revenue_period" t-on-change="(ev) => this.onKpiFilterChange('revenue_period', ev)"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="year">Cette année</option><option value="custom">Période</option></select></label><div t-if="state.kpiFilters.revenue_period === 'custom'" class="pt-eb-card-custom-dates"><label>Du<input type="date" aria-label="Date de début" t-att-value="kpiCustomRange('revenue_period').dateFrom" t-att-max="kpiCustomRange('revenue_period').dateTo || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('revenue_period', 'dateFrom', ev)"/></label><label>Au<input type="date" aria-label="Date de fin" t-att-value="kpiCustomRange('revenue_period').dateTo" t-att-min="kpiCustomRange('revenue_period').dateFrom || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('revenue_period', 'dateTo', ev)"/></label></div></div></header><section class="pt-revenue-highlight"><span>Chiffre d'affaires</span><strong><t t-esc="format(revenueSummary().total, 'FCFA')"/></strong><b t-att-class="revenueSummary().trend &gt;= 0 ? 'positive' : 'negative'"><i t-att-class="revenueSummary().trend &gt;= 0 ? 'fa fa-arrow-up' : 'fa fa-arrow-down'"/> <t t-esc="formatPercent(Math.abs(revenueSummary().trend))"/></b><small>vs période précédente</small></section><div class="pt-revenue-chart-toolbar"><button class="pt-revenue-chart-toggle" type="button" t-att-aria-expanded="!state.revenueChartHidden" t-on-click="toggleRevenueChart"><span><t t-esc="state.revenueChartHidden ? 'Afficher le graphe' : 'Masquer le graphe'"/></span><i t-att-class="state.revenueChartHidden ? 'fa fa-chevron-down' : 'fa fa-chevron-up'"/></button></div><section t-att-class="'pt-revenue-chart pt-revenue-cashflow-chart' + (state.revenueChartHidden ? ' is-hidden' : '')" t-att-aria-hidden="state.revenueChartHidden"><div class="pt-revenue-legend"><span class="income">Encaissements</span><span class="expense">Décaissements</span><span class="balance">Solde cumulé</span></div><div class="pt-revenue-y"><t t-foreach="revenueScaleLabels()" t-as="tick" t-key="tick.key"><span><t t-esc="tick.label"/></span></t></div><svg viewBox="0 0 100 100" preserveAspectRatio="none"><g class="pt-revenue-grid"><t t-foreach="revenueGridLines()" t-as="line" t-key="line.key"><line x1="0" x2="100" t-att-y1="line.y" t-att-y2="line.y"/><line y1="8" y2="88" t-att-x1="line.x" t-att-x2="line.x"/></t></g><path class="pt-revenue-line balance" t-att-d="revenueSeriesPath('balance')"/><path class="pt-revenue-line income" t-att-d="revenueSeriesPath('income')"/><path class="pt-revenue-line expense" t-att-d="revenueSeriesPath('expense')"/><t t-foreach="revenueSeriesDots('balance')" t-as="dot" t-key="dot.key"><circle class="balance" t-att-cx="dot.x" t-att-cy="dot.y" r="1.8"/></t><t t-foreach="revenueSeriesDots('income')" t-as="dot" t-key="dot.key"><circle class="income" t-att-cx="dot.x" t-att-cy="dot.y" r="1.8"/></t><t t-foreach="revenueSeriesDots('expense')" t-as="dot" t-key="dot.key"><circle class="expense" t-att-cx="dot.x" t-att-cy="dot.y" r="1.8"/></t></svg><div class="pt-revenue-x"><t t-foreach="state.revenue_chart.items" t-as="point" t-key="point.key"><span><t t-esc="point.label"/></span></t></div></section><footer class="pt-revenue-stats"><div><strong><t t-esc="format(revenueSummary().max, 'FCFA')"/></strong><span>Maximum</span></div><div><strong><t t-esc="format(revenueSummary().min, 'FCFA')"/></strong><span>Minimum</span></div><div><strong><t t-esc="format(revenueSummary().average, 'FCFA')"/></strong><span>Moyenne</span></div><div><strong><t t-esc="formatPercent(Math.abs(revenueSummary().trend))"/></strong><span>Évolution</span></div></footer></div><div class="pt-category-kpi"><header><div><h3>Répartition par catégorie</h3><small>Ventes facturées + PDV</small></div><div class="pt-category-menu-wrap"><button class="pt-kpi-more" title="Actions" t-on-click="toggleCategoryMenu"><i class="fa fa-ellipsis-v"/></button><div t-if="state.categoryMenuOpen" class="pt-category-action-menu"><button t-on-click="() => this.openCategoryAction(state.categories.action)"><i class="fa fa-bar-chart"/> Analyse détaillée</button><button t-on-click="() => this.openCategoryAction(state.categories.products_action)"><i class="fa fa-cubes"/> Catalogue produits</button><button t-on-click="refreshCategoryKpi"><i class="fa fa-refresh"/> Actualiser</button></div></div></header><section class="pt-category-total"><span>Total</span><strong><t t-esc="format(state.categories.total, 'FCFA')"/></strong></section><section class="pt-category-rows"><t t-foreach="state.categories.items" t-as="cat" t-key="cat.name"><button t-on-click="() => this.openAction(cat.action)"><span class="pt-category-name"><i/><t t-esc="cat.name"/></span><b><t t-esc="Math.round(cat.percent)"/>%</b><em><i t-att-style="'width:' + cat.percent + '%'"/></em><small><t t-esc="format(cat.value, 'FCFA')"/></small></button></t></section><footer>Mis à jour : <t t-esc="timeLabel()"/><button t-on-click="() => this.openCategoryAction(state.categories.action)">Voir le détail <i class="fa fa-file-text-o"/></button></footer></div></article>
            <article class="pt-eb-card alerts"><h3>Alertes</h3><t t-foreach="state.alerts" t-as="alert" t-key="alert.title"><div class="pt-eb-alert" t-on-click="() => this.openAction(alert.action)"><i t-att-class="alert.icon"/><p><strong><t t-esc="alert.title"/></strong><span><t t-esc="alert.detail"/></span></p></div></t></article>
        </section>

        <section class="pt-eb-grid-secondary" data-scroll-key="secondary-analysis">
            <article class="pt-eb-card"><header class="pt-eb-card-filter-header"><div><h3>Situation des caisses</h3><small>Sessions de caisse</small></div><div class="pt-eb-card-period"><label class="pt-eb-filter-control"><select class="pt-eb-filter-select" aria-label="Période de la situation des caisses" t-att-value="state.kpiFilters.cash_period" t-on-change="(ev) => this.onKpiFilterChange('cash_period', ev)"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="year">Cette année</option><option value="custom">Période</option></select></label><div t-if="state.kpiFilters.cash_period === 'custom'" class="pt-eb-card-custom-dates"><label>Du<input type="date" aria-label="Date de début" t-att-value="kpiCustomRange('cash_period').dateFrom" t-att-max="kpiCustomRange('cash_period').dateTo || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('cash_period', 'dateFrom', ev)"/></label><label>Au<input type="date" aria-label="Date de fin" t-att-value="kpiCustomRange('cash_period').dateTo" t-att-min="kpiCustomRange('cash_period').dateFrom || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('cash_period', 'dateTo', ev)"/></label></div></div></header><table><thead><tr><th>Caisse</th><th>Caissier</th><th>Solde</th><th>Statut</th></tr></thead><tbody><t t-foreach="state.cash" t-as="cash" t-key="cash.id or cash.name"><tr t-on-click="() => this.openAction(cash.action)"><td><t t-esc="cash.name"/></td><td><t t-esc="cash.cashier"/></td><td><t t-esc="format(cash.balance)"/></td><td><span t-att-class="'pt-eb-status ' + (cash.status_class || 'muted')"><t t-esc="cash.state"/></span></td></tr></t></tbody></table></article>
            <article class="pt-eb-card billing"><header class="pt-eb-card-filter-header"><div><h3>Situation de facturation</h3><small>Factures clients postées, encaissements et impayés</small></div><div class="pt-eb-card-period"><label class="pt-eb-filter-control"><select class="pt-eb-filter-select" aria-label="Période de la situation de facturation" t-att-value="state.kpiFilters.billing_period" t-on-change="(ev) => this.onKpiFilterChange('billing_period', ev)"><option value="today">Aujourd'hui</option><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="year">Cette année</option><option value="custom">Période</option></select></label><div t-if="state.kpiFilters.billing_period === 'custom'" class="pt-eb-card-custom-dates"><label>Du<input type="date" aria-label="Date de début" t-att-value="kpiCustomRange('billing_period').dateFrom" t-att-max="kpiCustomRange('billing_period').dateTo || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('billing_period', 'dateFrom', ev)"/></label><label>Au<input type="date" aria-label="Date de fin" t-att-value="kpiCustomRange('billing_period').dateTo" t-att-min="kpiCustomRange('billing_period').dateFrom || undefined" t-on-change="(ev) => this.onKpiCustomDateChange('billing_period', 'dateTo', ev)"/></label></div></div></header><div class="pt-eb-stock pt-eb-metric-list"><span t-on-click="() => this.openAction(state.billing.action)"><i class="fa fa-file-text-o tone-blue"/>Facturation totale</span><strong class="ok"><t t-esc="format(state.billing.total, 'FCFA')"/></strong><span t-on-click="() => this.openAction(state.billing.payments_action)"><i class="fa fa-shield tone-green"/>Total encaissement</span><strong class="ok"><t t-esc="format(state.billing.paid, 'FCFA')"/></strong><span t-on-click="() => this.openAction(state.billing.unpaid_action)"><i class="fa fa-home tone-orange"/>Factures impayées (créances)</span><strong class="danger"><t t-esc="format(state.billing.balance, 'FCFA')"/></strong><span t-on-click="() => this.openAction(state.billing.action)"><i class="fa fa-clipboard tone-slate"/>Nombre de factures</span><strong><t t-esc="format(state.billing.count)"/></strong><span t-on-click="() => this.openAction(state.billing.unpaid_action)"><i class="fa fa-times-circle tone-red"/>Taux d'impayé</span><strong class="danger"><t t-esc="formatPercent(state.billing.unpaid_rate)"/></strong></div><button class="pt-eb-detail-link" t-on-click="() => this.openAction(state.billing.action)">Voir le détail de la facturation</button></article><article class="pt-eb-card stock"><header class="pt-eb-card-filter-header"><div><h3>État des stocks</h3><small>Résumé stock.quant / product</small></div><label class="pt-eb-filter-control"><select class="pt-eb-filter-select" t-att-value="state.kpiFilters.stock_scope" t-on-change="(ev) => this.onKpiFilterChange('stock_scope', ev)"><option value="all">Global</option><option value="sale">Vente</option><option value="purchase">Achat</option></select></label></header><div class="pt-eb-stock"><span>Valeur totale du stock</span><strong><t t-esc="format(state.stock.value, 'FCFA')"/></strong><span t-on-click="() => this.openAction(state.stock.actions.products)">Nombre total de produits</span><strong><t t-esc="format(state.stock.products)"/></strong><span t-on-click="() => this.openAction(state.stock.actions.ruptures)">Produits en rupture</span><strong class="danger"><t t-esc="format(state.stock.ruptures)"/></strong><span t-on-click="() => this.openAction(state.stock.actions.minimum)">Produits sous stock minimum</span><strong class="warn"><t t-esc="format(state.stock.minimum)"/></strong><span t-on-click="() => this.openAction(state.stock.actions.overstock)">Produits en surstock</span><strong class="info"><t t-esc="format(state.stock.overstock)"/></strong></div><button class="pt-eb-detail-link" t-on-click="() => this.openAction(state.stock.actions.products)">Voir le détail des stocks</button></article>
            <article class="pt-eb-card"><h3>Situation bancaire</h3><small>Journaux par catégorie</small><t t-foreach="state.banks" t-as="bank" t-key="bank.id"><div class="pt-eb-bank" t-on-click="() => this.openAction(bank.action)"><span><i class="fa fa-bank"/> <t t-esc="bank.name"/></span><strong><t t-esc="format(bank.balance, 'FCFA')"/></strong></div></t></article>
        </section>


        <section class="pt-eb-logistics" data-scroll-key="logistics-summary">
            <article class="pt-eb-card"><h3>Centre de commandement logistique</h3><small>Demandes d'approvisionnement</small><div class="pt-mini-donut"><strong><t t-esc="state.supply.requests.total"/></strong><span>Total</span></div><t t-foreach="state.supply.requests.items" t-as="it" t-key="it.label"><div class="pt-eb-bank" t-on-click="() => this.openAction(it.action)"><span><t t-esc="it.label"/></span><strong><t t-esc="it.count"/></strong></div></t></article>
            <article class="pt-eb-card"><h3>Bons de transfert</h3><small>Statuts des transferts</small><div class="pt-mini-donut"><strong><t t-esc="state.supply.transfers.total"/></strong><span>Total</span></div><t t-foreach="state.supply.transfers.items" t-as="it" t-key="it.label"><div class="pt-eb-bank" t-on-click="() => this.openAction(it.action)"><span><t t-esc="it.label"/></span><strong><t t-esc="it.count"/></strong></div></t></article>
            <article class="pt-eb-card"><h3>Commandes clients</h3><small>Préparation &amp; livraison</small><div class="pt-mini-donut"><strong><t t-esc="state.supply.customers.total"/></strong><span>Total</span></div><t t-foreach="state.supply.customers.items" t-as="it" t-key="it.label"><div class="pt-eb-bank" t-on-click="() => this.openAction(it.action)"><span><t t-esc="it.label"/></span><strong><t t-esc="it.count"/></strong></div></t></article>
        </section>

        <section class="pt-eb-logistics-details" data-scroll-key="logistics-details">
            <article class="pt-eb-card"><h3>Charge de travail par magasin</h3><table><thead><tr><th>Magasin</th><th>Préparations</th><th>Commandes</th><th>Charge</th></tr></thead><tbody><t t-foreach="state.warehouse_load" t-as="wh" t-key="wh.name"><tr t-on-click="() => this.openAction(wh.action)"><td><t t-esc="wh.name"/></td><td><t t-esc="wh.prep"/></td><td><t t-esc="wh.orders"/></td><td><span class="load"><b t-att-style="'width:' + wh.load + '%'"/></span></td></tr></t></tbody></table></article>
            <article class="pt-eb-card"><h3>Alertes de stock</h3><t t-foreach="state.logistics_alerts" t-as="al" t-key="al.label"><div class="pt-eb-bank" t-on-click="() => this.openAction(al.action)"><span><t t-esc="al.label"/></span><strong><t t-esc="al.value"/></strong></div></t></article>
            <article class="pt-eb-card"><h3>Indicateurs logistiques</h3><t t-foreach="state.performance" t-as="perf" t-key="perf.label"><div class="pt-eb-bank"><span><t t-esc="perf.label"/></span><strong><t t-esc="perf.value"/></strong></div></t></article>
        </section>

        <section class="pt-eb-logistics-details" data-scroll-key="resources-details">
            <article class="pt-eb-card"><h3>Véhicules</h3><table><thead><tr><th>Véhicule</th><th>Type</th><th>Statut</th><th>Disponibilité</th></tr></thead><tbody><t t-foreach="state.vehicles" t-as="v" t-key="v.vehicle + v.type"><tr t-on-click="() => this.openAction(v.action)"><td><t t-esc="v.vehicle"/></td><td><t t-esc="v.type"/></td><td><span><t t-esc="v.status"/></span></td><td><t t-esc="v.availability"/></td></tr></t></tbody></table></article>
            <article class="pt-eb-card"><h3>Chauffeurs</h3><table><thead><tr><th>Chauffeur</th><th>Véhicule</th><th>Statut</th><th>Prochaine</th></tr></thead><tbody><t t-foreach="state.drivers" t-as="d" t-key="d.driver + d.status"><tr><td><t t-esc="d.driver"/></td><td><t t-esc="d.vehicle"/></td><td><span><t t-esc="d.status"/></span></td><td><t t-esc="d.next"/></td></tr></t></tbody></table></article>
            <article class="pt-eb-card"><h3>Top produits à surveiller</h3><table><thead><tr><th>Produit</th><th>Rayon</th><th>Statut</th><th>Stock</th></tr></thead><tbody><t t-foreach="state.top_watch" t-as="p" t-key="p.product"><tr t-on-click="() => this.openAction(p.action)"><td><t t-esc="p.product"/></td><td><t t-esc="p.rayon"/></td><td><span><t t-esc="p.status"/></span></td><td><t t-esc="format(p.stock)"/></td></tr></t></tbody></table></article>
        </section>

        <section class="pt-eb-bottom pt-eb-history-grid" data-scroll-key="history">
            <article class="pt-eb-card pt-eb-history-card activities">
                <header class="pt-eb-history-header"><div><h3><i class="fa fa-heartbeat"/> Dernières activités</h3><small>Historique des actions récentes effectuées dans le système</small></div><button class="pt-eb-more" t-on-click="() => this.openAction(state.activity_history_action)">Voir tout <i class="fa fa-angle-right"/></button></header>
                <div class="pt-eb-table-scroll"><table class="pt-eb-history-table"><thead><tr><th>Date / Heure</th><th>Utilisateur</th><th>Action / Événement</th><th>Description détaillée</th><th>Document</th><th>Statut</th></tr></thead><tbody><t t-foreach="state.activities" t-as="act" t-key="act.key"><tr t-on-click="() => this.openAction(act.action_ref)"><td class="pt-eb-date"><t t-esc="act.date"/></td><td><strong><t t-esc="act.user"/></strong><small><t t-esc="act.role"/></small></td><td><span t-att-class="'pt-eb-event-badge ' + act.tone"><i t-att-class="'fa ' + act.icon"/> <t t-esc="act.action"/></span></td><td><t t-esc="act.description"/></td><td><strong><t t-esc="act.doc"/></strong></td><td><span t-att-class="'pt-eb-state-badge ' + act.tone"><t t-esc="act.state"/></span></td></tr></t></tbody></table></div>
            </article>
            <article class="pt-eb-card pt-eb-history-card audit">
                <header class="pt-eb-history-header"><div><h3><i class="fa fa-shield"/> Journal d'audit</h3><small>Journal des événements système et modifications des données</small></div><button class="pt-eb-more" t-on-click="() => this.openAction(state.audit_history_action)">Voir tout <i class="fa fa-angle-right"/></button></header>
                <div class="pt-eb-table-scroll"><table class="pt-eb-history-table"><thead><tr><th>Date / Heure</th><th>Utilisateur</th><th>Action / Événement</th><th>Description détaillée</th><th>Module</th><th>IP / Appareil</th></tr></thead><tbody><t t-foreach="state.audit" t-as="a" t-key="a.key"><tr t-on-click="() => this.openAction(a.action_ref)"><td class="pt-eb-date"><t t-esc="a.date"/></td><td><strong><t t-esc="a.user"/></strong><small><t t-esc="a.role"/></small></td><td><span t-att-class="'pt-eb-event-badge ' + a.tone"><i t-att-class="'fa ' + a.icon"/> <t t-esc="a.action"/></span></td><td><t t-esc="a.description"/></td><td><strong><t t-esc="a.module"/></strong></td><td><strong><t t-esc="a.ip"/></strong><small><t t-esc="a.device"/></small></td></tr></t></tbody></table></div>
            </article>
            <article class="pt-eb-card performance"><h3>Indicateurs de performance</h3><small><t t-esc="state.performance_period_label || state.period_label || 'Aujourd\'hui'"/></small><t t-foreach="state.performance" t-as="perf" t-key="perf.label"><div class="pt-eb-perf"><i class="fa fa-line-chart"/><span><t t-esc="perf.label"/></span><strong><t t-esc="perf.value"/></strong><em><t t-esc="perf.trend"/></em><b><i t-att-style="'width:' + (perf.percent || 0) + '%'"/></b></div></t></article>
        </section>

        <footer class="pt-eb-footer">Dernière mise à jour : <strong><t t-esc="todayLabel()"/> <t t-esc="timeLabel()"/></strong> <i class="fa fa-refresh"/></footer>
    </div>
</t>
</templates>
