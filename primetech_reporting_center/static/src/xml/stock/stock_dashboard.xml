<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
<t t-name="primetech_reporting_center.StockDashboard">
<div t-att-class="dashboardClass" t-att-style="dashboardStyle">
    <t t-if="state.loading"><div class="pt-stock-loading"><i class="fa fa-spinner fa-spin fa-3x"/><h4>Chargement du Dashboard...</h4></div></t>
    <t t-if="!state.loading">
        <header class="pt-stock-header"><h1>Stock &amp; Supply Chain - Vue d'ensemble</h1><div class="pt-stock-icons"><button t-on-click="refresh"><i class="fa fa-refresh"/></button><button t-on-click="openSettings"><i class="fa fa-cog"/></button><button><i class="fa fa-expand"/></button></div></header>
        <section class="pt-stock-filters"><label>Société<select><option>Toutes les sociétés</option></select></label><label>Période<select t-att-value="state.period" t-on-change="(ev) => this.setPeriod(ev.target.value)"><option value="week">Cette semaine</option><option value="month">Ce mois</option><option value="quarter">Ce trimestre</option><option value="year">Cette année</option></select></label><span>Actualisé le : <t t-esc="state.data.updated_at"/></span></section>

        <section class="pt-stock-kpis">
            <button class="pt-stock-kpi" t-on-click="() => this.openProducts()"><span>Valeur totale du stock</span><strong><t t-esc="money(state.data.stock_value)"/></strong><em>▲ <t t-esc="pct(state.data.stock_value_growth)"/></em><small><t t-esc="money(state.data.previous_stock_value)"/></small></button>
            <button class="pt-stock-kpi" t-on-click="() => this.openProducts([['qty_available', '&gt;', 0]])"><span>Quantité disponible</span><strong><t t-esc="state.data.available_qty"/> unités</strong><em>▲ <t t-esc="pct(state.data.available_growth)"/></em><small><t t-esc="state.data.previous_available_qty"/></small></button>
            <button class="pt-stock-kpi" t-on-click="() => this.openProducts([['qty_available', '&lt;=', 0]])"><span>Produits en rupture</span><strong><t t-esc="state.data.out_of_stock"/></strong><em class="down">▼ <t t-esc="pct(state.data.out_of_stock_growth)"/></em><small><t t-esc="state.data.previous_out_of_stock"/></small></button>
            <button class="pt-stock-kpi" t-on-click="() => this.openProducts([['id', 'in', state.data.below_min_product_ids]])"><span>Sous minimum</span><strong><t t-esc="state.data.below_min"/></strong><em>▲ <t t-esc="pct(state.data.below_min_growth)"/></em><small><t t-esc="state.data.previous_below_min"/></small></button>
            <button class="pt-stock-kpi" t-on-click="() => this.openProducts([['id', 'in', state.data.overstock_product_ids]])"><span>Stock en surstock</span><strong><t t-esc="state.data.overstock"/></strong><em>▲ <t t-esc="pct(state.data.overstock_growth)"/></em><small><t t-esc="state.data.previous_overstock"/></small></button>
            <button class="pt-stock-kpi" t-on-click="() => this.openMoves()"><span>Couverture moyenne</span><strong><t t-esc="state.data.coverage_days"/> jours</strong><em>▲ <t t-esc="pct(state.data.coverage_growth)"/></em><small><t t-esc="state.data.previous_coverage_days"/></small></button>
            <button class="pt-stock-kpi" t-on-click="() => this.openMoves()"><span>Rotation moyenne</span><strong><t t-esc="state.data.rotation"/> fois</strong><em>▲ <t t-esc="pct(state.data.rotation_growth)"/></em><small><t t-esc="state.data.previous_rotation"/></small></button>
        </section>

        <section class="pt-stock-grid-top">
            <article class="pt-stock-card"><div class="pt-stock-card-title"><h3>Stock par entrepôt</h3><label>Trier / filtrer <select t-att-value="state.warehouseSort" t-on-change="onWarehouseSortChange"><option value="value_desc">Valeur décroissante</option><option value="value_asc">Valeur croissante</option><option value="name_asc">Emplacement A-Z</option><option value="date_desc">Dernier mouvement</option></select></label></div><table><thead><tr><th>Entrepôt</th><th>Valeur stock</th><th>Disponible</th><th>Réservé</th><th>Entrant</th><th>Sortant</th></tr></thead><tbody><tr t-foreach="sortedWarehouses()" t-as="wh" t-key="wh.id" t-on-click="() => this.openLocations([['id', '=', wh.id]])"><td><t t-esc="wh.name"/></td><td><t t-esc="money(wh.value)"/></td><td><t t-esc="wh.available"/></td><td><t t-esc="wh.reserved"/></td><td><t t-esc="wh.incoming"/></td><td><t t-esc="wh.outgoing"/></td></tr></tbody></table><button class="pt-card-link" t-on-click="() => this.openLocations()">Voir tous les entrepôts</button></article>
            <article class="pt-stock-card"><h3>Mouvements (période)</h3><div class="pt-stock-chart"><canvas id="stockMovementsChart"/></div></article>
        </section>

        <section class="pt-stock-grid-bottom">
            <article class="pt-stock-card"><h3>Produits en rupture</h3><table><thead><tr><th>Produit</th><th>Référence</th><th>Emplacement</th><th>Qté demandée</th></tr></thead><tbody><tr t-foreach="state.data.shortage_products || []" t-as="product" t-key="product.id" t-on-click="() => this.openProducts([['id', '=', product.id]])"><td><t t-esc="product.name"/></td><td><t t-esc="product.reference"/></td><td><t t-esc="product.location"/></td><td><t t-esc="product.qty"/></td></tr></tbody></table><button class="pt-card-link" t-on-click="() => this.openProducts([['qty_available', '&lt;=', 0]])">Voir tous les produits</button></article>
            <article class="pt-stock-card"><h3>Demandes de réapprovisionnement</h3><table><thead><tr><th>Produit</th><th>Emplacement</th><th>Qté suggérée</th><th>Priorité</th><th>Statut</th></tr></thead><tbody><tr t-foreach="state.data.replenishments || []" t-as="req" t-key="req.id" t-on-click="() => this.openReplenishments([['id', '=', req.product_id]])"><td><t t-esc="req.product"/></td><td><t t-esc="req.location"/></td><td><t t-esc="req.qty"/></td><td><t t-esc="req.priority"/></td><td><t t-esc="req.status"/></td></tr></tbody></table><button class="pt-card-link" t-on-click="() => this.openReplenishments()">Voir toutes les demandes</button></article>
            <article class="pt-stock-card pt-stock-alerts"><h3>Alertes stock</h3><button t-on-click="() => this.openProducts([['qty_available', '&lt;=', 0]])"><i class="fa fa-exclamation-circle"/> <t t-esc="state.data.alerts.stockout"/> produits en rupture</button><button t-on-click="() => this.openProducts([['id', 'in', state.data.below_min_product_ids]])"><i class="fa fa-warning"/> <t t-esc="state.data.alerts.below_min"/> produits sous minimum</button><button t-on-click="() => this.openProducts([['id', 'in', state.data.overstock_product_ids]])"><i class="fa fa-arrow-up"/> <t t-esc="state.data.alerts.overstock"/> produits en surstock</button><button t-on-click="() => this.openTransfers([['scheduled_date', '&lt;', state.data.today], ['state', 'not in', ['done', 'cancel']]])"><i class="fa fa-clock-o"/> <t t-esc="state.data.alerts.late_replenishments"/> réceptions en retard</button><button t-on-click="() => this.openProducts()"><i class="fa fa-calendar-times-o"/> <t t-esc="state.data.alerts.soon_expiring_lots"/> lots expirent sous 30 jours</button><button class="pt-alert-link" t-on-click="() => this.openProducts([['qty_available', '&lt;=', 0]])">Voir toutes les alertes</button></article>
        </section>

        <section class="pt-stock-actions"><h3>Actions rapides</h3><button t-on-click="() => this.openTransfers([['picking_type_id.code', '=', 'incoming']])"><i class="fa fa-file-o blue"/> Réception</button><button t-on-click="() => this.openTransfers([['picking_type_id.code', '=', 'outgoing']])"><i class="fa fa-truck green"/> Livraison</button><button t-on-click="() => this.openTransfers([['picking_type_id.code', '=', 'internal']])"><i class="fa fa-exchange purple"/> Transfert interne</button><button t-on-click="() => this.openMoves()"><i class="fa fa-clipboard orange"/> Inventaire</button><button t-on-click="() => this.openReplenishments()"><i class="fa fa-file-text-o purple"/> Demande de réappro.</button><button t-on-click="() => this.openMoves()"><i class="fa fa-random teal"/> Ajustement stock</button><button t-on-click="() => this.openProducts()"><i class="fa fa-file-pdf-o cyan"/> Rapport stock</button></section>
    </t>
</div>
</t>
</templates>
