<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
<t t-name="primetech_reporting_center.AccountingDashboard" owl="1">
<main class="pt-accounting-overview">
    <t t-if="state.loading"><div class="pt-accounting-loading"><i class="fa fa-spinner fa-spin fa-3x"/> Chargement…</div></t>
    <t t-else="">
        <header class="pt-accounting-header"><h1>Comptabilité - Vue d'ensemble</h1><div class="pt-accounting-icons"><button t-on-click="loadData"><i class="fa fa-refresh"/></button><button><i class="fa fa-cog"/></button><button><i class="fa fa-expand"/></button></div></header>
        <section class="pt-accounting-filters"><label>Société<select t-att-value="state.filters.company_id" t-on-change="onCompanyChange"><option value="">Toutes les sociétés</option><t t-foreach="state.data.filters.companies || []" t-as="company" t-key="company.id"><option t-att-value="company.id"><t t-esc="company.name"/></option></t></select></label><label>Période<select t-att-value="state.filters.period" t-on-change="onPeriodChange"><t t-foreach="state.data.filters.periods || []" t-as="period" t-key="period.value"><option t-att-value="period.value"><t t-esc="period.label"/></option></t></select></label><label>Comparaison<select t-att-value="state.filters.comparison" t-on-change="onComparisonChange"><t t-foreach="state.data.filters.comparisons || []" t-as="comparison" t-key="comparison.value"><option t-att-value="comparison.value"><t t-esc="comparison.label"/></option></t></select></label><span>Période : <t t-esc="state.data.filters.date_from"/> → <t t-esc="state.data.filters.date_to"/> · Actualisé le : <t t-esc="state.data.updated_at"/></span></section>

        <section class="pt-accounting-kpis">
            <button class="pt-accounting-kpi" t-on-click="() => this.openInvoices()"><span>Chiffre d'affaires</span><strong><t t-esc="money(state.data.revenue.value)"/></strong><em>▲ <t t-esc="pct(state.data.revenue.variation)"/></em><small><t t-esc="money(state.data.previous_revenue)"/></small></button>
            <button class="pt-accounting-kpi" t-on-click="() => this.openJournalItems()"><span>Résultat net</span><strong><t t-esc="money(state.data.net_result)"/></strong><em>▲ <t t-esc="pct(state.data.net_result_growth)"/></em><small><t t-esc="money(state.data.previous_net_result)"/></small></button>
            <button class="pt-accounting-kpi" t-on-click="() => this.openAccounts()"><span>Trésorerie disponible</span><strong><t t-esc="money(state.data.cash)"/></strong><em>▲ <t t-esc="pct(state.data.cash_growth)"/></em><small><t t-esc="money(state.data.previous_cash)"/></small></button>
            <button class="pt-accounting-kpi" t-on-click="() => this.openInvoices([['payment_state', '!=', 'paid']])"><span>Créances clients</span><strong><t t-esc="money(state.data.receivables)"/></strong><em class="down">▼ <t t-esc="pct(state.data.receivables_growth)"/></em><small><t t-esc="money(state.data.previous_receivables)"/></small></button>
            <button class="pt-accounting-kpi" t-on-click="() => this.openBills([['payment_state', '!=', 'paid']])"><span>Dettes fournisseurs</span><strong><t t-esc="money(state.data.payables)"/></strong><em>▲ <t t-esc="pct(state.data.payables_growth)"/></em><small><t t-esc="money(state.data.previous_payables)"/></small></button>
            <button class="pt-accounting-kpi" t-on-click="() => this.openJournalItems()"><span>Marge nette</span><strong><t t-esc="pct(state.data.net_margin)"/></strong><em>▲ <t t-esc="pct(state.data.net_margin_growth)"/></em><small><t t-esc="pct(state.data.previous_net_margin)"/></small></button>
        </section>

        <section class="pt-accounting-grid-top">
            <article class="pt-accounting-card"><h3><i class="fa fa-money"/> Situation de caisse</h3><select><option>Caisse principale</option></select><div class="pt-accounting-list"><button t-on-click="() => this.openAccounts()"><span>Solde initial</span><strong><t t-esc="money(state.data.cash_position.opening)"/></strong></button><button t-on-click="() => this.openInvoices([['payment_state', 'in', ['paid', 'in_payment']]])"><span>Encaissements</span><strong><t t-esc="money(state.data.cashflow.incoming)"/></strong></button><button t-on-click="() => this.openBills([['payment_state', 'in', ['paid', 'in_payment']]])"><span>Décaissements</span><strong><t t-esc="money(state.data.cashflow.outgoing)"/></strong></button><button t-on-click="() => this.openAccounts()"><span>Solde théorique</span><strong><t t-esc="money(state.data.cash_position.theoretical)"/></strong></button><button t-on-click="() => this.openAccounts()"><span>Solde réel</span><strong><t t-esc="money(state.data.cash_position.real)"/></strong></button><button><span>Caissier</span><strong><t t-esc="state.data.cash_position.cashier"/></strong></button><button><span>Statut</span><strong><t t-esc="state.data.cash_position.status"/></strong></button></div><button class="pt-card-link" t-on-click="openTrialBalance">Voir le détail</button></article>
            <article class="pt-accounting-card"><h3><i class="fa fa-file-text-o"/> Situation de facturation</h3><select><option>Journal de vente</option></select><div class="pt-accounting-list"><button t-on-click="() => this.openInvoices()"><span>Total facturé</span><strong><t t-esc="money(state.data.revenue.value)"/></strong></button><button t-on-click="() => this.openInvoices([['payment_state', 'in', ['paid', 'in_payment']]])"><span>Total encaissé</span><strong><t t-esc="money(state.data.cashflow.incoming)"/></strong></button><button t-on-click="() => this.openInvoices([['payment_state', '=', 'paid']])"><span>Factures payées</span><strong><t t-esc="state.data.invoice_counts.paid"/></strong></button><button t-on-click="() => this.openInvoices([['payment_state', '=', 'partial']])"><span>Factures partiellement payées</span><strong><t t-esc="state.data.invoice_counts.partial"/></strong></button><button t-on-click="() => this.openInvoices([['payment_state', 'in', ['not_paid', 'partial']]])"><span>Factures impayées</span><strong><t t-esc="state.data.invoice_counts.open"/></strong></button><button><span>Délai moyen de paiement</span><strong class="danger"><t t-esc="state.data.average_payment_delay"/> jours</strong></button><button><span>Taux de recouvrement</span><strong><t t-esc="pct(state.data.collection_rate)"/></strong></button></div><button class="pt-card-link" t-on-click="() => this.openInvoices()">Voir les factures</button></article>
            <article class="pt-accounting-card"><h3><i class="fa fa-line-chart"/> Trésorerie</h3><div class="pt-accounting-chart"><canvas id="accountingTreasuryChart"/></div><button class="pt-card-link" t-on-click="() => this.openJournalItems()">Voir la trésorerie</button></article>
            <article class="pt-accounting-card"><h3><i class="fa fa-pie-chart"/> Répartition des disponibilités</h3><div class="pt-accounting-chart-list"><div class="pt-accounting-donut"><canvas id="accountingCashChart"/></div><ul><li t-foreach="state.data.cash_accounts || []" t-as="account" t-key="account.id" t-on-click="() => this.openAccounts([['id', '=', account.id]])"><b/><span><t t-esc="account.name"/></span><strong><t t-esc="money(account.amount)"/> (<t t-esc="pct(account.percent)"/>)</strong></li></ul></div><button class="pt-card-link" t-on-click="() => this.openAccounts()">Voir les comptes</button></article>
        </section>

        <section class="pt-accounting-grid-bottom">
            <article class="pt-accounting-card"><h3>Créances clients (ancienneté)</h3><div class="pt-accounting-chart-list"><div class="pt-accounting-donut"><canvas id="accountingAgeChart"/></div><ul><li t-foreach="state.data.receivable_aging || []" t-as="age" t-key="age.label" t-on-click="() => this.openInvoices(age.domain)"><b/><span><t t-esc="age.label"/></span><strong><t t-esc="money(age.amount)"/> (<t t-esc="pct(age.percent)"/>)</strong></li></ul></div><button class="pt-card-link" t-on-click="() => this.openInvoices([['payment_state', '!=', 'paid']])">Voir les créances</button></article>
            <article class="pt-accounting-card"><h3>Top 5 clients débiteurs</h3><table><thead><tr><th>Client</th><th>Montant dû</th><th>Échu</th><th>+ Anc. échéance</th></tr></thead><tbody><tr t-foreach="state.data.debtors || []" t-as="debtor" t-key="debtor.id" t-on-click="() => this.openPartners([debtor.id])"><td><t t-esc="debtor.name"/></td><td><t t-esc="money(debtor.amount)"/></td><td><t t-esc="money(debtor.overdue)"/></td><td class="danger"><t t-esc="debtor.oldest_due"/></td></tr></tbody></table><button class="pt-card-link" t-on-click="() => this.openPartners((state.data.debtors || []).map((d) => d.id))">Voir tous les clients</button></article>
            <article class="pt-accounting-card pt-accounting-alerts"><h3>Alertes comptables</h3><button t-on-click="() => this.openInvoices([['invoice_date_due', '&lt;', state.data.today], ['payment_state', '!=', 'paid']])"><i class="fa fa-exclamation-circle"/> <t t-esc="state.data.alerts.overdue_customer_invoices"/> factures clients échues</button><button t-on-click="() => this.openBills([['invoice_date_due', '&lt;', state.data.today], ['payment_state', '!=', 'paid']])"><i class="fa fa-user-times"/> <t t-esc="state.data.alerts.overdue_vendor_bills"/> factures fournisseurs échues</button><button t-on-click="() => this.openJournalItems()"><i class="fa fa-sitemap"/> <t t-esc="state.data.alerts.unbalanced_entries"/> écritures non équilibrées</button><button t-on-click="() => this.openJournalItems([['move_id.state', '=', 'draft']])"><i class="fa fa-pencil"/> <t t-esc="state.data.alerts.unposted_journals"/> journaux non clôturés</button><button t-on-click="openTrialBalance"><i class="fa fa-clock-o"/> <t t-esc="state.data.alerts.cash_not_closed"/> caisse non clôturée</button><button class="pt-alert-link" t-on-click="() => this.openInvoices([['payment_state', '!=', 'paid']])">Voir toutes les alertes</button></article>
        </section>
    </t>
</main>
</t>
</templates>
